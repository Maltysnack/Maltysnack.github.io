system Valley;

Spring    -> Reservoir -> Town;
Tributary -> Town;

river  Spring    { base: 40, peak: 6.0, decay: 0.6 }
river  Tributary { base: 10, peak: 3.0 }
dam    Reservoir { capacity: 30, threshold: 80%,
                   normalRate: 4, openRate: 20 }
outlet Town;

print Valley [30, 0, 0, 45, 0];
