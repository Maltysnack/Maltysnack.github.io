mode grid;
system Ring;

Plant -[4]-> North;
Plant -[4]-> South;
North -[2]-> East;
South -[2]-> East;

node Plant { supply:  100 }
node North { supply:  -25 }
node East  { supply:  -40 }
node South { supply:  -35 }

compare Ring 500 as
  "Baseline",
  "North line cut" with disable Plant -> North,
  "East line cut"  with disable South -> East;
