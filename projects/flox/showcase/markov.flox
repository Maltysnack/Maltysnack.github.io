mode markov;
system Possession;

Defence  -[0.4]-> Defence;
Defence  -[0.6]-> Midfield;
Midfield -[0.3]-> Defence;
Midfield -[0.3]-> Midfield;
Midfield -[0.4]-> Attack;
Attack   -[0.3]-> Defence;
Attack   -[0.3]-> Midfield;
Attack   -[0.2]-> Attack;
Attack   -[0.2]-> Shot;
Shot     -[0.9]-> Defence;
Shot     -[0.1]-> Goal;
Goal     -[1.0]-> Midfield;

node Defence;  node Midfield;  node Attack;  node Shot;  node Goal;

start Defence 1.0;
print Possession 200;
